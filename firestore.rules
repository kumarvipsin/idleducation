
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * EduVerse Security Rules
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update, delete: if isExistingOwner(userId) && request.resource.data.id == userId;

      match /studyPlans/{studyPlanId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update, delete: if isExistingOwner(userId) && request.resource.data.userId == userId;
      }

      match /progress/{progressId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update, delete: if isExistingOwner(userId) && request.resource.data.userId == userId;
      }
    }

    match /blogPosts/{postId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /content/{contentId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Default rules for other collections used in the app
    match /{path=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
