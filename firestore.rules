rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * EDUVERSE SECURITY RULES
     * 
     * Core Philosophy:
     * This ruleset enforces a strict user-ownership model for personalized data (profiles, study plans, progress)
     * while maintaining a public-read model for educational resources (curriculums, subjects, content).
     * Administrative access is handled via a dedicated /roles_admin collection (Database Access Control).
     *
     * Data Structure:
     * - /users/{userId}: Primary user profile (Owner-access).
     * - /users/{userId}/studyPlans: Personalized AI-generated paths (Owner-access).
     * - /users/{userId}/userProgress: Content engagement tracking (Owner-access).
     * - /curriculums, /learningContents: Publicly discoverable educational data (Public Read, Admin Write).
     * - /userAccessLogs: Audit trail for registrations and logins (Admin Only).
     *
     * Key Security Decisions:
     * 1. Authorization Independence: Subcollections use path-based wildcards ({userId}) to avoid costly get() calls.
     * 2. DBAC (Database Access Control): Admin status is verified by the existence of a document in /roles_admin.
     * 3. Prototyping Flexibility: Schema validation is limited to relational integrity (e.g., matching IDs) 
     *    to allow rapid UI iteration without breaking rules on every field change.
     * 4. Relational Integrity: On creation of user-scoped data, the internal userId field must match the path.
     */

    // --- Helper Functions ---

    /** Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Checks if the authenticated user's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Checks if the authenticated user has an entry in the roles_admin collection. */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /** Combines ownership check with existence check for updates and deletes. */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Collection Rules ---

    /**
     * @description Rules for the root User profile.
     * @path /users/{userId}
     * @allow (create) if auth.uid matches {userId}.
     * @deny (read) if user is not the profile owner.
     * @principle Enforces self-creation and strict owner-only access for profiles.
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);

      /**
       * @description Rules for personalized study plans.
       * @path /users/{userId}/studyPlans/{studyPlanId}
       * @allow (list) if the user owns the parent path.
       * @deny (update) if the internal userId is changed.
       * @principle Path-based ownership with relational integrity check on userId.
       */
      match /studyPlans/{studyPlanId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Rules for tracking user learning progress.
       * @path /users/{userId}/userProgress/{progressId}
       * @allow (create) if the user sets their own UID.
       * @deny (read) for any other user.
       * @principle Restricts progress data to the specific student.
       */
      match /userProgress/{progressId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }
    }

    /**
     * @description Educational curricula available to all users.
     * @path /curriculums/{curriculumId}
     * @allow (get, list) for any visitor (even unauthenticated).
     * @deny (write) if the user is not a verified admin.
     * @principle Public consumption with restricted administrative management.
     */
    match /curriculums/{curriculumId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();

      /**
       * @description Subjects nested within a specific curriculum.
       * @path /curriculums/{curriculumId}/subjects/{subjectId}
       * @allow (read) public access.
       * @principle Inherits the public-read/admin-write posture of the parent collection.
       */
      match /subjects/{subjectId} {
        allow get, list: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    /**
     * @description Global collection of all learning materials.
     * @path /learningContents/{contentId}
     * @allow (list) for all users to support discovery.
     * @deny (delete) for non-admin users.
     * @principle Centralized repository for educational content with public visibility.
     */
    match /learningContents/{contentId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description System-wide access and registration logs for auditing.
     * @path /userAccessLogs/{logId}
     * @allow (read) only for administrators.
     * @deny (write) from client SDKs; logs are typically server-generated.
     * @principle Protects sensitive access logs and registration attempts from public view.
     */
    match /userAccessLogs/{logId} {
      allow get, list: if isAdmin();
      // IR specifies write access is exclusively by server-side logic
      allow create, update, delete: if false;
    }

    /**
     * @description Defines which users have administrative privileges.
     * @path /roles_admin/{adminId}
     * @allow (read, write) only for existing administrators.
     * @principle Strict DBAC (Database Access Control) management.
     */
    match /roles_admin/{adminId} {
      allow get, list, create, update, delete: if isAdmin();
    }
  }
}