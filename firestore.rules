rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * EDUVERSE SECURITY RULES
     *
     * CORE PHILOSOPHY:
     * This ruleset enforces a strict ownership model for personal user data and a role-based
     * model for educational content. It prioritizes "Authorization Independence," ensuring that 
     * security decisions for sub-documents do not require costly lookups to parent documents.
     *
     * DATA STRUCTURE:
     * - /users/{userId}: Private user profiles and preferences.
     * - /users/{userId}/studyPlans: User-specific personalized learning paths.
     * - /users/{userId}/userProgress: Granular tracking of user interactions.
     * - /admins/{adminId}: A registry of users with elevated privileges.
     * - /curricula/...: A public hierarchy of educational content (Curricula -> Courses -> Subjects -> Materials/Exams/Questions).
     *
     * KEY SECURITY DECISIONS:
     * - Denormalization for Authorization: User IDs are stored both in the path and within documents 
     *   (e.g., userId, creatorId) to allow fast, non-relational ownership checks.
     * - Structural Segregation: Educational content is kept in a global tree, readable by all 
     *   authenticated users but modifiable only by those present in the /admins collection.
     * - Prototyping Mode: Rules enforce "Who" (Authorization) and "Relational Links" (Integrity) 
     *   but do not restrict the specific fields or data types of the content itself.
     */

    // --- Helper Functions ---

    /** @description Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks ownership and ensures the document already exists for update/delete. */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /** @description Checks if the authenticated user is registered in the admins collection. */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // --- Collection Rules ---

    /**
     * @description Rules for user profile documents. Ensures users can only manage their own profile.
     * @path /users/{userId}
     * @allow (get, list, create, update) if auth.uid == userId
     * @deny (create) if auth.uid != userId
     * @principle Enforces path-based ownership and validates internal ID consistency.
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if false; // Profiles are generally preserved; delete requires admin or special logic.
    }

    /**
     * @description Registry for administrative users. Used to grant write access to global content.
     * @path /admins/{adminId}
     * @allow (get) if auth.uid == adminId
     * @deny (list) if not an admin
     * @principle Role-based access control via a dedicated collection.
     */
    match /admins/{adminId} {
      allow get: if isOwner(adminId);
      allow list: if isAdmin();
      allow create, update, delete: if false; // Admin status managed via backend/console for security.
    }

    /**
     * @description Rules for global educational content. Publicly readable, admin-only writes.
     * @path /curricula/{curriculumId}
     * @allow (get, list) if signedIn
     * @deny (write) if not an admin
     * @principle Authenticated read access with admin-restricted content management.
     */
    match /curricula/{curriculumId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && resource != null;

      // Nested Courses
      match /courses/{courseId} {
        allow get, list: if isSignedIn();
        allow create: if isAdmin() && request.resource.data.curriculumId == curriculumId;
        allow update: if isAdmin() && resource != null && request.resource.data.curriculumId == resource.data.curriculumId;
        allow delete: if isAdmin() && resource != null;

        // Nested Subjects
        match /subjects/{subjectId} {
          allow get, list: if isSignedIn();
          allow create: if isAdmin() && request.resource.data.courseId == courseId;
          allow update: if isAdmin() && resource != null && request.resource.data.courseId == resource.data.courseId;
          allow delete: if isAdmin() && resource != null;

          // Nested Materials, Exams, and Questions
          match /learningMaterials/{materialId} {
            allow get, list: if isSignedIn();
            allow create: if isAdmin() && request.resource.data.subjectId == subjectId;
            allow update: if isAdmin() && resource != null && request.resource.data.subjectId == resource.data.subjectId;
            allow delete: if isAdmin() && resource != null;
          }

          match /exams/{examId} {
            allow get, list: if isSignedIn();
            allow create: if isAdmin() && request.resource.data.subjectId == subjectId;
            allow update: if isAdmin() && resource != null && request.resource.data.subjectId == resource.data.subjectId;
            allow delete: if isAdmin() && resource != null;
          }

          match /questions/{questionId} {
            allow get, list: if isSignedIn();
            allow create: if isAdmin() && request.resource.data.subjectId == subjectId;
            allow update: if isAdmin() && resource != null && request.resource.data.subjectId == resource.data.subjectId;
            allow delete: if isAdmin() && resource != null;
          }
        }
      }
    }

    /**
     * @description Personalized study plans. Restricted to the owner.
     * @path /users/{userId}/studyPlans/{studyPlanId}
     * @allow (create, update) if auth.uid == userId
     * @deny (list) if auth.uid != userId
     * @principle Path-based ownership with denormalized field validation for relational integrity.
     */
    match /users/{userId}/studyPlans/{studyPlanId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description User progress tracking. Highly sensitive private data.
     * @path /users/{userId}/userProgress/{userProgressId}
     * @allow (all) if auth.uid == userId
     * @deny (get) if auth.uid != userId
     * @principle Ensures users can only view and modify their own learning progress.
     */
    match /users/{userId}/userProgress/{userProgressId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }
  }
}