/**
 * Educational Platform Security Rules
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for all personal data (profiles, study plans,
 * progress, and test results) while providing a robust administrative layer for content management.
 * Security is handled at the path level to ensure atomic authorization without costly lookups.
 *
 * Data Structure:
 * - /users/{userId}: The root for all user-specific data. Document IDs match Auth UIDs.
 * - /boards, /examTypes, /subjects: Static reference data for the platform.
 * - /courses, /practiceTests, /questions: The learning content hierarchy.
 * - /roles_admin/{adminUid}: A dedicated collection for identifying administrative users.
 *
 * Key Security Decisions:
 * 1. Ownership: Users have full access to their own /users/{userId} tree.
 * 2. Content Visibility: Learning content (courses, modules, etc.) uses an 'isPublished' 
 *    flag to control public visibility. 
 * 3. Administrative Control: All write operations on public content are restricted 
 *    to users identified in the /roles_admin collection.
 * 4. Question Privacy: Questions and AnswerOptions are readable by signed-in users 
 *    to facilitate test-taking but are not listable to prevent content scraping.
 *
 * Denormalization for Authorization:
 * - Ownership fields (userId) are required on creation for all user-scoped documents 
 *   to ensure path-to-data consistency.
 * - 'isPublished' flags are used on content documents for fast, single-document read checks.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    /** @description Checks if the user is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks ownership and ensures the document exists for updates/deletes. */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /** @description Checks if the authenticated user has administrative privileges. */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /** @description Checks if a document is marked as published. */
    function isPublished() {
      return resource.data.isPublished == true;
    }

    // --- Collection Rules ---

    /**
     * @description Rules for the UserProfile entity. Users manage their own profiles.
     * @path /users/{userId}
     * @allow create: if isOwner(userId) && request.resource.data.id == userId;
     * @deny update: if request.resource.data.id != resource.data.id;
     * @principle Pattern 1 (Ownership) & Pattern 4 (Self-Creation).
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);

      /**
       * @description Personalized study plans.
       * @path /users/{userId}/studyPlans/{studyPlanId}
       * @allow create: if isOwner(userId) && request.resource.data.userId == userId;
       * @principle Enforces path-based ownership and relational integrity.
       */
      match /studyPlans/{studyPlanId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);

        /**
         * @description Tasks within a study plan.
         * @path /users/{userId}/studyPlans/{studyPlanId}/tasks/{studyPlanTaskId}
         */
        match /tasks/{studyPlanTaskId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && request.resource.data.studyPlanId == studyPlanId;
          allow update: if isExistingOwner(userId) && request.resource.data.studyPlanId == resource.data.studyPlanId;
          allow delete: if isExistingOwner(userId);
        }
      }

      /**
       * @description Tracking progress for courses and content.
       * @path /users/{userId}/courseProgress/{courseId}
       */
      match /courseProgress/{courseId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }

      match /contentProgress/{contentItemId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Records of user test attempts and their answers.
       * @path /users/{userId}/testAttempts/{testAttemptId}
       */
      match /testAttempts/{testAttemptId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);

        match /answers/{answerId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && request.resource.data.userTestAttemptId == testAttemptId;
          allow update: if isExistingOwner(userId) && request.resource.data.userTestAttemptId == resource.data.userTestAttemptId;
          allow delete: if isExistingOwner(userId);
        }
      }
    }

    /**
     * @description Reference data collections. Public read, Admin write.
     * @path /boards/{boardId}, /examTypes/{examTypeId}, /subjects/{subjectId}
     * @allow get: if true;
     * @deny create: if !isAdmin();
     * @principle Restricted administrative writes for global reference data.
     */
    match /boards/{boardId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    match /examTypes/{examTypeId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    match /subjects/{subjectId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Learning content (Courses, Modules, ContentItems). Visible if published.
     * @path /courses/{courseId}
     * @allow list: if resource.data.isPublished == true || isAdmin();
     * @principle Pattern 5 (Public Read with Admin Writes).
     */
    match /courses/{courseId} {
      allow get, list: if isPublished() || isAdmin();
      allow create, update, delete: if isAdmin();

      match /modules/{moduleId} {
        allow get, list: if isPublished() || isAdmin();
        allow create, update, delete: if isAdmin();

        match /contentItems/{contentItemId} {
          allow get, list: if isPublished() || isAdmin();
          allow create, update, delete: if isAdmin();
        }
      }
    }

    /**
     * @description Practice tests. Visible if published.
     * @path /practiceTests/{practiceTestId}
     */
    match /practiceTests/{practiceTestId} {
      allow get, list: if isPublished() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Question pool. Restricted listing to prevent scraping.
     * @path /questions/{questionId}
     * @allow get: if isSignedIn();
     * @deny list: if !isAdmin();
     * @principle Limits bulk data access while allowing functional app usage.
     */
    match /questions/{questionId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      match /answerOptions/{answerOptionId} {
        allow get: if isSignedIn();
        allow list: if isAdmin();
        allow create, update, delete: if isAdmin();
      }
    }

    /**
     * @description Administrative roles. Read-only for verification.
     * @path /roles_admin/{adminUid}
     */
    match /roles_admin/{adminUid} {
      allow get: if isSignedIn();
      allow list, write: if false;
    }
  }
}